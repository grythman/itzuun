[flake8]
max-line-length = 88
extend-ignore = E203, W503
exclude =
    */migrations/*,
    .git,
    __pycache__,
    .venv,
    venv

per-file-ignores =
    config/settings/*.py: F401, F403, F405
    */tests/*.py: F841
    */test_*.py: F841
    apps/messaging/services.py: F401
    apps/messaging/views.py: F401, E402
    apps/notifications/views.py: F401
    apps/payments/views.py: F401, F811
    apps/projects/services.py: F401, F811, E402
    apps/projects/urls.py: F401
    apps/projects/views.py: F401
    apps/projects/tests/test_views.py: F401
    apps/reviews/views.py: F401
    common/management/commands/kpi_segment_report.py: F401
